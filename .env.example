# Web: copy to apps/web/.env.local. Worker: copy to .env at repository root.
# Do not put worker-only secrets in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved for manual administrative tasks; the application does not use this key.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel: transaction pooler URL with forged_web role, sslmode=verify-full
DATABASE_URL=
# Web only: public Supabase CA bundle contents for verified serverless TLS
SUPABASE_CA_CERT_PEM=
# Worker only: direct or session-pooler URL with forged_worker role, sslmode=verify-full
WORKER_DATABASE_URL=
# Optional local connection assembly when WORKER_DATABASE_URL is empty
SUPABASE_PROJECT_REF=
SUPABASE_POOLER_HOST=
WORKER_DATABASE_PASSWORD=
# Public Supabase CA bundle file for verified TLS
SUPABASE_CA_CERT_PATH=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_INPUT_BYTES=262144000
MAX_OUTPUT_BYTES=1073741824
DAILY_JOB_LIMIT=10
# Worker only
TIKQUICK_API_KEY=
TIKQUICK_PASSPORT_URL=https://tikquick.online
TIKQUICK_PS_URL=https://ps.tikquick.online
TIKQUICK_ENCODER_URL=https://encoder.tikquick.online
TIKQUICK_CHUNK_BYTES=20971520
TIKQUICK_CHUNK_CONCURRENCY=2
TIKQUICK_CHUNK_MAX_ATTEMPTS=5
TIKQUICK_CHUNK_RETRY_BASE_MS=600
# Provider expiry example is timezone-naive. Confirm offset with provider.
TIKQUICK_TOKEN_TIMEZONE_OFFSET=Z
INTERNAL_HEALTH_TOKEN=
PORT=8080
# Set to 127.0.0.1 when running the worker on your own PC
WORKER_BIND_HOST=0.0.0.0
FFMPEG_PATH=
FFPROBE_PATH=
ENABLE_TIKTOK_PUBLISHING=false
# Optional test-only PostgreSQL admin connection; never a production database.
TEST_DATABASE_URL=
